# Compiler output accidentally emitted next to the sources. The files list in
# each manifest packs everything under src, so a stray artifact here ships.
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.map

# Throwaway probes and one-off outputs
.scratch/

# npm auth token, never committed
.npmrc

# Tact build output. The bindings the packages publish are committed under
# packages/*/src/contracts/; a second copy here drifted from them. The .fc and
# .fif files are compiler intermediates that nothing in this repository reads.
contracts/output/*.ts
contracts/output/*.fc
contracts/output/*.fif
